# ── سرویس ──
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# ── آینه دانلود موتورهای Prisma (برای ایران — رفع ECONNRESET) ──
PRISMA_ENGINES_MIRROR=https://registry.npmmirror.com/-/binary/prisma

# ── دیتابیس (MongoDB Atlas) ──
DATABASE_URL="mongodb://user:pass@cluster-shard-00-00.xxxxx.mongodb.net:27017,...cluster-shard-00-02.xxxxx.mongodb.net:27017/megan_online_db?ssl=true&replicaSet=xxx&authSource=admin"

# ── توکن‌ها ──
JWT_SECRET="change-me-min-16-chars"
JWT_EXPIRES_IN="7d"
REFRESH_TOKEN_TTL_DAYS=30

# ── CORS و مستندات ──
CORS_ORIGINS="*"
SWAGGER_ENABLED=true

# ── OTP ──
# کد ثابت تا رسیدن پنل پیامک — با آمدن پنل، خالی بگذارید تا کد تصادفی ۴ رقمی صادر شود
OTP_FIXED_CODE=1234

# ── کیف پول (B9) ──
WALLET_CARD_NUMBER=6037-9975-1234-5678
WALLET_CARD_OWNER=شرکت بازارگاه ایمچ

# ── Web Push (VAPID) ──
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:support@imach.ir"

# ── ذخیره‌سازی فایل‌ها (ArvanCloud S3-compatible) ──
STORAGE_DRIVER=arvan            # arvan | local
MAX_FILE_SIZE=5242880           # ۵ مگابایت (قاعده باسکول)
FILES_STAGING_TTL_DAYS=7        # عمر فایل‌های staged قبل از reaper
UPLOAD_PATH=./uploads           # فقط درایور local
PUBLIC_BASE_URL=                # فقط درایور local پشت پروکسی
ARVAN_ENDPOINT=https://<bucket>.s3.ir-thr-at1.arvanstorage.ir
ARVAN_REGION=ir-thr-at1
ARVAN_ACCESS_KEY=""
ARVAN_SECRET_KEY=""
ARVAN_BUCKET_NAME=""
