# ── پروفایل اجرا (کلید واحد لوکال/ابر — docs/LOCAL-DEV.md) ──
# cloud (پیش‌فرض) → Atlas + آروان | local → مونگوی لوکال + فایل روی دیسک ./uploads
# برای کار آفلاین/استیج لوکال فقط همین یک خط را local کنید و ری‌استارت بدهید؛
# DATABASE_URL و ARVAN_* در پروفایل local نادیده گرفته می‌شوند.
APP_PROFILE=cloud

# فقط پروفایل local (اختیاری — پیش‌فرض‌ها برای توسعه لوکال کافی است):
# LOCAL_DATABASE_URL="mongodb://127.0.0.1:27017/megan_local"
# LOCAL_PUBLIC_BASE_URL="http://localhost:4000"

# ── سرویس ──
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# ── آینه دانلود موتورهای Prisma (برای ایران — رفع ECONNRESET) ──
PRISMA_ENGINES_MIRROR=https://registry.npmmirror.com/-/binary/prisma

# ── دیتابیس (MongoDB Atlas) ──
DATABASE_URL="mongodb://user:pass@cluster-shard-00-00.xxxxx.mongodb.net:27017,...cluster-shard-00-02.xxxxx.mongodb.net:27017/megan_online_db?ssl=true&replicaSet=xxx&authSource=admin"

# ── توکن‌ها ──
JWT_SECRET="change-me-min-16-chars"
JWT_EXPIRES_IN="7d"
REFRESH_TOKEN_TTL_DAYS=30

# ── CORS و مستندات ──
# توسعه: باز؛ پروداکشن: فقط دامنه‌های واقعی (B11)
CORS_ORIGINS="*"
# CORS_ORIGINS="https://imach.ir,https://www.imach.ir"
# در پروداکشن به‌جز با true صریح خاموش می‌ماند (B11)
SWAGGER_ENABLED=true

# ── OTP ──
# کد ثابت تا رسیدن پنل پیامک — با آمدن پنل، خالی بگذارید تا کد تصادفی ۴ رقمی صادر شود
OTP_FIXED_CODE=1234

# ── کیف پول (B9) ──
WALLET_CARD_NUMBER=6037-9975-1234-5678
WALLET_CARD_OWNER=شرکت بازارگاه ایمچ

# ── Web Push (VAPID) ──
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:support@imach.ir"

# ── ذخیره‌سازی فایل‌ها (ArvanCloud S3-compatible) ──
# توجه: اگر APP_PROFILE=local باشد درایور اجباراً local می‌شود و این کلیدها بی‌اثرند.
STORAGE_DRIVER=arvan            # arvan | local
MAX_FILE_SIZE=5242880           # ۵ مگابایت (قاعده باسکول)
FILES_STAGING_TTL_DAYS=7        # عمر فایل‌های staged قبل از reaper
UPLOAD_PATH=./uploads           # فقط درایور local
PUBLIC_BASE_URL=                # فقط درایور local پشت پروکسی
ARVAN_ENDPOINT=https://<bucket>.s3.ir-thr-at1.arvanstorage.ir
ARVAN_REGION=ir-thr-at1
ARVAN_ACCESS_KEY=""
ARVAN_SECRET_KEY=""
ARVAN_BUCKET_NAME=""

# ── پنل ادمین (بوت‌استرپ اولیه) ──
# فقط وقتی هیچ ادمینی در DB نیست اثر دارد؛ پس از آن DB منبع حقیقت است.
# اگر رمز ست نشده باشد، رمز تصادفی قوی تولید و یک‌بار در لاگ بوت چاپ می‌شود.
ADMIN_DEFAULT_USERNAME="09196421264"
ADMIN_DEFAULT_PASSWORD=""            # خالی بگذارید تا رمز تصادفی تولید شود

# ── ایمپورتر باسکول (ابزار ادمین /panel/importer) ──
# تاخیر بین هر درخواست به باسکول (میلی‌ثانیه) — 5000 یعنی مؤدبانه و آرام
BUSKOOL_DELAY_MS=5000
# کوکی سشن باسکول — با آن متن کامل کامنت‌ها دریافت می‌شود (اختیاری)
BUSKOOL_COOKIE=""
# تنها شماره‌ای که اجازهٔ cleanup/ایمپورت دارد (پیش‌فرض: 09196421264)
IMPORTER_ADMIN_PHONE="09196421264"
# دیتابیس منبع MySQL برای ایمپورت لیستی فاز ۲ (اختیاری؛ نیازمند bun add mysql2)
# IMPORT_SOURCE_DB_URL="mysql://user:pass@host:3306/imach_online_db"
# IMPORT_SOURCE_TABLE="User-buskool"
# IMPORT_SOURCE_PHONE_COLUMN="phone"
# IMPORT_SOURCE_USERNAME_COLUMN="user_name"
