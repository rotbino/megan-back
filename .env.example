# سرویس
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# MongoDB Atlas
DATABASE_URL="mongodb://USER:PASS@cluster-shard-00-00.xxxxx.mongodb.net:27017,.../megan_online_db?ssl=true&replicaSet=...&authSource=admin"

# احراز هویت
JWT_SECRET="یک-رشته-تصادفی-بلند"
JWT_EXPIRES_IN="7d"
REFRESH_TOKEN_TTL_DAYS=30

# شبکه
CORS_ORIGINS="*"
SWAGGER_ENABLED=true

# Web Push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@example.com

# ArvanCloud Object Storage (S3-compatible)
ARVAN_ENDPOINT=https://BUCKET.s3.REGION.arvanstorage.ir
ARVAN_REGION=ir-thr-at1
ARVAN_ACCESS_KEY=
ARVAN_SECRET_KEY=
ARVAN_BUCKET_NAME=
