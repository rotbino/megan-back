# نمونهٔ متغیرهای محیطی ابزار ویرایش تصویر
# اولویت: python/image-editing/.env > megan-back/.env > متغیر محیط (فقط با مقدار معتبر)
# فقط برای remove_one و selftest نیازی به DATABASE_URL و کلیدهای آروان نیست.

DATABASE_URL=mongodb+srv://USER:PASS@CLUSTER/megan_online_db
ARVAN_ENDPOINT=https://<bucket>.s3.ir-thr-at1.arvanstorage.ir
ARVAN_REGION=us-east-1
ARVAN_ACCESS_KEY=xxxxxxxx
ARVAN_SECRET_KEY=xxxxxxxx
ARVAN_BUCKET_NAME=<bucket>
