// ─────────────────────────────────────────────────────────────────────────────
// Megan (iMach) — Prisma schema on MongoDB Atlas
//
// اصول:
//  • نام فیلدها در دیتابیس snake_case عین باسکول (product_name, min_sale_price,
//    province_id …) تا داده‌های کراول‌شده از باسکول بدون تبدیل اینزرت شوند.
//  • داده‌های پایه (Category/Province/City/Product) id عددی باسکول دارند
//    (پسته=44، اصفهان=4، شهر بابک=230) — Prisma روی مونگو id صریح عددی را
//    پشتیبانی می‌کند؛ شمارنده جدول Counter برای id محصولات جدید.
//  • تصاویر هر مدل از طریق جدول چندریختی File مدیریت می‌شوند (دکترین
//    imach-back): fieldKey اسلات را تعیین می‌کند، ردیف staged قبل از چسبیدن
//    به مدل توسط reaper حذف می‌شود و replace اول آپلود می‌کند بعد قبلی را
//    پاک می‌کند — هیچ فایل سرگردانی روی حافظه گران نمی‌ماند.
//  • TTL ایندکس در Prisma پشتیبانی نمی‌شود → پاک‌سازی OTP/RefreshToken با
//    reaper دوره‌ای درون پروسه انجام می‌شود.
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ─── Users & Auth ────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  /// شماره موبایل — تنها راه ورود (روش سشن؛ OTP برای آینده پنل پیامک)
  phone     String   @unique
  /// رمز عبور اختیاری پنل — تا تعیین نشود، ورود فقط با موبایل ممکن است
  /// (scrypt؛ خالی = کاربر هنوز رمز تعیین نکرده — بنر قرمز پنل فعال می‌ماند)
  passwordHash String? @map("password_hash")
  /// شناسه عمومی پروفایل مثل باسکول (wbrstu2g1) — هنگام ثبت‌نام تولید می‌شود
  userName  String   @unique @map("user_name")
  firstName String   @default("") @map("first_name")
  lastName  String   @default("") @map("last_name")
  /// «آقا» / «خانم» — مثل باسکول
  sex       String?
  role      String   @default("USER") // USER | ADMIN
  /// احراز هویت (کارت ملی + سلفی) — جریان ادمین
  isVerified   Boolean @default(false) @map("is_verified")
  /// نقش فعال پنل — پیش‌فرض فروشنده (خواسته مالک)؛ با سوییچ پنل عوض می‌شود
  /// و همان انتخاب ماندگار است (is_buyer=true و is_seller=false → پنل خریدار)
  isBuyer      Boolean @default(false) @map("is_buyer")
  isSeller     Boolean @default(true) @map("is_seller")
  /// غیرفعال توسط ادمین (A3) — ورود مسدود و محتوا از لیست‌های عمومی پنهان
  /// می‌شود؛ داده‌ها حذف نمی‌شوند (حذف نرم، نه سخت)
  isActive     Boolean  @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  /// آخرین نبض حضور — heartbeat/WS آن را تازه می‌کند؛ «آنلاین» یعنی
  /// تازه‌تر از پنجره ~۹۰ ثانیه (grace برای پرش شبکه). ایندکس desc برای
  /// شمار/فیلتر آنلاین‌ها در پنل ادمین.
  lastSeenAt   DateTime? @map("last_seen_at")
  /// مهر خروج صریح — بستن صفحه (بیکن leave)، لاگ‌اوت یا قطع آخرین سوکت.
  /// «آنلاین» = lastSeenAt تازه «و» offlineAt نداشتن؛ هر touch این فیلد را
  /// null می‌کند و هر خروج واقعی هر دو مهر را به «اکنون» می‌زند — خروج
  /// بدون انتظار برای پیرشدن پنجره ۹۰ثانیه‌ای فوری دیده می‌شود.
  offlineAt    DateTime? @map("offline_at")
  /// مهر زمان ابطال همه نشست‌ها (لاگ‌اوت سمت سرور) — توکن‌هایی که
  /// iat قبل از آن باشند رد می‌شوند؛ null یعنی هیچ ابطالی ثبت نشده
  sessionsRevokedAt DateTime? @map("sessions_revoked_at")
  walletBalance Int     @default(0) @map("wallet_balance") // تومان
  avatarUrl    String? @map("avatar_url")
  businessDesc String? @map("business_desc")
  /// مکان پیش‌فرض کاربر — ثبت‌نام/فرم‌ها با آن پیش‌پر می‌شوند (id عددی باسکول)
  provinceId   Int?    @map("province_id")
  cityId       Int?    @map("city_id")
  /// پروفایل کسب‌وکار embedded — فیلدهای myuser_profiles باسکول
  profile    Json?

  files        File[]         @relation("FileOwner")
  products     Product[]      @relation("ProductOwner")
  refreshTokens RefreshToken[]
  verificationOrders VerificationOrder[] @relation("VerificationOwner")
  buyRequests  BuyRequest[]   @relation("BuyRequestOwner")
  chargeOrders ChargeOrder[]  @relation("ChargeOrderOwner")
  ladderOrders LadderOrder[]  @relation("LadderOrderOwner")
  savedLists   SavedList[]    @relation("SavedListOwner")
  savedTargets SavedUser[]    @relation("SavedTarget")
  chatThreadsAsSeller ChatThread[] @relation("ChatThreadSeller")
  chatThreadsAsBuyer  ChatThread[] @relation("ChatThreadBuyer")
  /// گزارش تماس — تماس‌گیرنده (شماره طرف را دیده/زنگ زده)
  callsMade     CallLog[]      @relation("CallCaller")
  /// گزارش تماس — دریافت‌کننده (صاحب شماره)
  callsReceived CallLog[]      @relation("CallCallee")
  pushSubscriptions  PushSubscription[] @relation("PushOwner")
  walletAdjustments  WalletAdjustment[] @relation("WalletAdjustmentOwner")
  /// پیام‌های مستقیم پشتیبانی (ادمین → کاربر) — یک‌طرفه با خوانده‌شدن
  adminMessages   AdminMessage[] @relation("AdminMessageOwner")
  /// نظراتی که درباره این کاربر (به‌عنوان فروشنده) نوشته شده
  reviewsReceived SellerReview[] @relation("ReviewSeller")
  /// نظراتی که این کاربر درباره فروشندگان نوشته
  reviewsWritten SellerReview[] @relation("ReviewAuthor")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([lastSeenAt(sort: Desc)])
}

/// درخواست احراز هویت اسناد — کارت ملی + سلفی؛ بررسی و تأیید توسط ادمین.
/// مدارک از جدول File (relatedModel=Verification, fieldKey=nationalCard|selfie)
/// به سفارش می‌چسبند — دکترین ضد-فایل-سرگردان imach-back (بخش ۵ سند).
model VerificationOrder {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @map("user_id") @db.ObjectId
  user      User     @relation("VerificationOwner", fields: [userId], references: [id], onDelete: Cascade)

  /// pending | approved | rejected
  status         String   @default("pending")
  rejectionReason String? @map("rejection_reason")
  /// کاربر ادمین بررسی‌کننده
  reviewedBy String?   @map("reviewed_by") @db.ObjectId
  reviewedAt DateTime? @map("reviewed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, status])
  @@index([status, createdAt(sort: Desc)])
}

/// کد OTP — هش sha256، عمر ۲ دقیقه، پاک‌سازی دوره‌ای توسط reaper
model OtpCode {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  phone     String
  codeHash  String   @map("code_hash")
  expiresAt DateTime @map("expires_at")
  /// شمارش تلاش‌های اشتباه (بعد از ۵ بار کد باطل می‌شود)
  attempts  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([phone, createdAt(sort: Desc)])
  @@index([expiresAt])
}

/// رفرش‌توکن چرخشی — فقط هش sha256 ذخیره می‌شود
model RefreshToken {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  tokenHash String    @unique @map("token_hash")
  userId    String    @map("user_id") @db.ObjectId
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
}

/// کاربر پنل ادمین — جدایی کامل از User عادی (فولدر src/admin در API و
/// src/app/admin در فرانت). ورود با نام کاربری + رمز (scrypt).
/// SUPER_ADMIN می‌تواند ادمین بسازد/غیرفعال کند (فاز A5).
model AdminUser {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  /// نام کاربری ورود پنل ادمین — می‌تواند شماره موبایل باشد
  username     String   @unique
  passwordHash String   @map("password_hash")
  name         String   @default("مدیر سیستم")
  /// SUPER_ADMIN | ADMIN (نقش‌های ریزتر در فازهای بعد)
  role         String   @default("ADMIN")
  isActive     Boolean  @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")

  /// لاگ عملیات‌های این ادمین (AdminAction — فاز A5)
  actions      AdminAction[] @relation("AdminActionActor")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
}

/// لاگ عملیات ادمین (فاز A5) — ثبت خودکار هر mutation ادمین توسط
/// AdminActionInterceptor (کی عملیات را انجام داده، روی چه هدفی، با چه خلاصه‌ای).
/// فقط شناسه ادمین ذخیره می‌شود؛ نام/نقش هنگام خواندن join می‌شود (اصل نرمال‌سازی).
model AdminAction {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  adminId   String    @map("admin_id") @db.ObjectId
  admin     AdminUser @relation("AdminActionActor", fields: [adminId], references: [id])

  /// مسیر عملیات — مثل admin/products/reviewProduct
  action     String
  /// نوع هدف — product | user | buy_request | charge_order | base_data | admin
  targetType String?   @map("target_type")
  /// شناسه هدف (اگر از body قابل استخراج باشد)
  targetId   String?   @map("target_id")
  /// خلاصه body — بدون فیلدهای حساس (رمز…) و رشته‌های بلند
  payload    Json?
  /// پیام موفقیت عملیات (از پاسخ یکنواخت API)
  message    String?

  createdAt DateTime  @default(now()) @map("created_at")

  @@index([adminId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([action])
}

/// اشتراک وب‌پوش مرورگر (B10) — endpoint یکتای هر مرورگر/دستگاه؛
/// ۴۱۰/۴۰۴ از سرویس پوش = اشتراک منقضی → حذف خودکار موقع ارسال
model PushSubscription {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @map("user_id") @db.ObjectId
  user      User     @relation("PushOwner", fields: [userId], references: [id], onDelete: Cascade)
  /// endpoint سرویس پوش مرورگر — سراسری یکتا (upsert بر اساس همین)
  endpoint  String   @unique
  /// کلیدهای رمز‌گذاری اشتراک (RFC 8291)
  p256dh    String
  auth      String
  userAgent String?  @map("user_agent")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
}

/// شمارنده id عددی (الگوی کلاسیک مونگو) — seq با increment اتمیک بالا می‌رود
model Counter {
  id  String @id @map("_id") // مثل "product"
  seq Int    @default(0)
}

// ─── داده‌های پایه باسکول (id عددی باسکول) ──────────────────────────────────

/// درخت دسته سه‌سطحی — id/parent_id عددی باسکول
model Category {
  id           Int     @id @map("_id") // پسته=44
  parentId     Int?    @map("parent_id")
  categoryName String  @map("category_name")
  slug         String
  /// CATEGORY (دسته) | PRODUCT_TYPE (نوع کالا — فرزند کاربر-ساختهٔ برگ، برای RFQ آینده)
  kind         String  @default("CATEGORY")
  /// واحد فروش پیش‌فرض (کیلوگرم)
  unit         String  @default("")
  /// حداقل سفارش پیش‌فرض
  min          Int     @default(0)
  /// نمونه ورودی «نوع {دسته} خود را وارد کنید» (مثل: اکبری)
  example      String?
  score        Int     @default(0)

  @@index([parentId, kind, score])
  @@index([slug])
}

/// ─── لوکیشن درختی واحد ───────────────────────────────────────────────────────
/// به‌جای دو جدول جداگانهٔ استان/شهر، یک کالکشن واحد با ساختار درختی:
///   province ← city ← region ← neighborhood …
/// «فقط یک جدول لوکیشن که فقط تایپش متفاوت باشه» — خواستهٔ مالک؛ سطح‌های
/// آینده (منطقه/محله) بدون مهاجرت، فقط با type جدید + parent_id اضافه می‌شوند.
///
/// ⚠️ چرا id رشتهٔ ترکیبی است؟ چون id های عددی باسکول در دو فضای جدا هستند و
/// برخورد عددی دارند (شهر ۴ = بستان‌آبادِ آذربایجان شرقی، استان ۴ = اصفهان) —
/// یعنی «عدد + نوع» با هم یکتا هستند. کلید یکتا: «province:4» / «city:230».
/// عدد خام باسکول در buskolId حفظ می‌شود و در API ها همان id عددی برمی‌گردد؛
/// آگهی‌ها/درخواست‌ها به همان اعداد خام اشاره می‌کنند (بدون تغییر).
model Location {
  /// کلید یکتای سراسری — «province:4» | «city:230» | «region:…"
  id        String  @id @map("_id")
  /// id عددی باسکول در نوع خودش — یکتا فقط با هم type
  buskolId  Int     @map("buskool_id")
  /// province | city | region | neighborhood
  type      String
  /// کلید گره والد («province:4») — null یعنی ریشه (استان)
  parentId  String? @map("parent_id")
  /// نام فارسی
  name      String
  enName    String? @map("en_name")
  latitude  Float?
  longitude Float?
  /// فعال/غیرفعال (A2) — مکان غیرفعال از لیست‌های عمومی پنهان می‌شود و
  /// ثبت آگهی/درخواست جدید روی آن ممکن نیست؛ آگهی‌های قدیمی نامشان را همچنان resolve می‌کنند
  isActive  Boolean @default(true) @map("is_active")

  @@unique([type, buskolId])
  @@index([type, parentId])
  @@index([type, name])
}

// ─── Files (دکترین imach-back) ───────────────────────────────────────────────

/// جدول چندریختی File — تصویر/پیوست هر مدلی با fieldKey مشخص می‌شود:
///   User.avatar · Product.gallery · (آینده: ChargeOrder.receipt, Verification.docs)
/// ردیف staged (relatedId=null) اگر تا TTL به مدلی نچسبد → reaper حذفش می‌کند.
/// ⚠️ relatedId رشته ساده است (نه ObjectId) — چندریختی: id کاربر ObjectId است
/// اما id محصول عدد باسکول؛ هر دو به شکل رشته ذخیره/کوئری می‌شوند.
model File {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  ownerId     String   @map("owner_id") @db.ObjectId
  owner       User     @relation("FileOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  /// نام مدل مقصد — فقط مقادیر RELATED_MODELS سرویس
  relatedModel String  @map("related_model")
  /// id مدل مقصد (رشته) — null یعنی staged
  relatedId   String?  @map("related_id")
  /// اسلات: avatar | gallery | receipt | …
  fieldKey    String   @map("field_key")
  /// توضیح اختیاری
  description String?
  /// نام فایل اصلی (فقط نمایش)
  name        String
  mimeType    String   @map("mime_type")
  /// حجم فایل اصلی بعد از فشرده‌سازی (بایت)
  size        Int
  /// URL عمومی مستقیم — بدون توکن، از CDN
  url         String
  thumbUrl    String?  @map("thumb_url")
  /// کلید ذخیره‌سازی فایل اصلی (دستگیره حذف/تعویض پروایدر) — null برای URL خارجی
  storageKey  String?  @map("storage_key")
  thumbStorageKey String? @map("thumb_storage_key")
  /// متادیتا (ابعاد، حجم اصلی، …)
  metadata    Json?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([relatedModel, relatedId, fieldKey])
  @@index([ownerId])
  @@index([relatedModel, relatedId])
  @@index([createdAt])
}

// ─── Products (آگهی — عین ساختار باسکول) ─────────────────────────────────────

model Product {
  /// id عددی (باسکول برای seed، Counter برای جدید)
  id            Int     @id @map("_id")
  productName   String  @map("product_name")
  /// slug سئوپذیر — خرید-عمده-{نام}-{id}
  slug          String
  description   String

  /// دسته پدر (خشکبار=45)
  categoryId    Int     @map("category_id")
  /// دسته برگ (پسته=44)
  subCategoryId Int     @map("sub_category_id")
  /// واحد فروش دسته (کیلوگرم) — denorm
  unit          String

  provinceId    Int     @map("province_id")
  cityId        Int     @map("city_id")

  /// موجودی آماده فروش
  stock         Int
  /// حداقل میزان فروش در هر معامله
  minSaleAmount Int     @map("min_sale_amount")
  /// کف قیمت هر واحد (تومان) — 0 یعنی «تماس بگیرید»
  minSalePrice  Int     @map("min_sale_price")

  /// جزئیات نهایی مرحله ۶ ویزارد — [{key, value}]
  features      Json?
  status        String  @default("pending") // pending | confirmed | rejected | deleted
  /// دلایل رد — آرایه رشته
  rejectionReasons Json? @map("rejection_reasons")

  /// نردبان — آگهی نردبان‌شده بالای «مرتبط‌ترین» (۱۰۰هزار/ماه)
  isLadder        Boolean   @default(false) @map("is_ladder")
  ladderExpiresAt DateTime? @map("ladder_expires_at")

  hasVideo   Boolean @default(false) @map("has_video")
  isOld      Boolean @default(false) @map("is_old")
  viewCount  Int     @default(0) @map("view_count")

  userId String @map("user_id") @db.ObjectId
  user   User   @relation("ProductOwner", fields: [userId], references: [id], onDelete: Cascade)

  // ⚠️ ساختار درست داده: هیچ مشخصات کاربر/نام نمایشی داخل رکورد تکرار نمی‌شود.
  // رابطه یک‌به‌چند User↔Product فقط با user_id برقرار است؛ نام فروشنده/دسته/
  // مکان در لحظه خواندن با join (Prisma include + کش‌های base) ساخته می‌شود.
  // (فقط «unit» عمداً می‌ماند: اسنپ‌شات واحدِ آگهی در لحظه ثبت — جزو داده‌ی خود آگهی است.)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  chatThreads  ChatThread[]  @relation("ChatThreadProduct")
  ladderOrders LadderOrder[] @relation("LadderProduct")
  callLogs     CallLog[]     @relation("CallLogProduct")

  /// سورت «مرتبط‌ترین» = نردبان اول، بعد جدیدترین
  @@index([status, isLadder, updatedAt(sort: Desc)])
  @@index([subCategoryId, status])
  @@index([provinceId, cityId, status])
  @@index([userId, status])
  @@index([slug])
}

// ─── درخواست‌های خرید (RFQ) — عین ساختار get_buyAd_list باسکول ───────────────

/// درخواست خرید — جمله کارت باسکول: «خریدار {requirementAmount} {unit}
/// {categoryName} از نوع {name} هستم». ⚠️ نام‌گذاری عین باسکول:
///   name = «نوع محصول» (پاجوش پیارم) — به‌زودی به نود PRODUCT_TYPE ارجاع
///   categoryId = دسته برگ (نهال) — در پاسخ باسکول subcategory_name
model BuyRequest {
  /// id عددی باسکول برای seed؛ Counter برای درخواست‌های جدید
  id                Int     @id @map("_id")
  /// «نوع محصول» مثل: پاجوش پیارم — در باسکول nullable
  name              String?
  description       String?

  /// دسته برگ (بهداشت شخصی=1035)
  categoryId        Int     @map("category_id")
  /// نود PRODUCT_TYPE Categories در صورت انتخاب از پیشنهادها
  productTypeId     Int?    @map("product_type_id")

  /// میزان نیازمندی (۶۰۰ عدد / ۱۰٬۰۰۰ کیلوگرم)
  requirementAmount Int     @map("requirement_amount")
  /// واحد سفارش — از واحد دسته
  unit              String  @default("کیلوگرم")

  provinceId        Int?    @map("province_id")
  cityId            Int?    @map("city_id")

  /// هدف: price_and_buy (قیمت + خرید) | price_only (فقط اطلاع از قیمت)
  goal              String  @default("price_and_buy")
  /// سابقه خرید عمده این کالا از قبل
  hasHistory        Boolean @default(false) @map("has_history")

  /// pending | confirmed | rejected | deleted — تب‌های «درخواستهای من»
  status            String  @default("pending")
  rejectionReason   String? @map("rejection_reason")

  userId String @map("user_id") @db.ObjectId
  user   User   @relation("BuyRequestOwner", fields: [userId], references: [id], onDelete: Cascade)

  // ⚠️ ساختار درست داده: نام دسته/مکان و مشخصات خریدار در رکورد نیست —
  // در لحظه خواندن با join (درخت دسته کش‌شده + کالکشن Location + User) ساخته می‌شود.

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status, createdAt(sort: Desc)])
  @@index([categoryId, status])
  @@index([userId, status])
}

// ─── CRM نشان‌شده‌ها — عین پنل باسکول (SavedList/SavedUser/Note) ────────────

/// لیست نشان‌شده‌ها — نام آزاد مثل «سیب زمینی»؛ یکتا به‌ازای کاربر
model SavedList {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @map("user_id") @db.ObjectId
  user   User   @relation("SavedListOwner", fields: [userId], references: [id], onDelete: Cascade)

  name      String
  savedUsers SavedUser[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, name])
}

/// خریدار نشان‌شده در یک لیست — وضعیت ۷گانه CRM باسکول
model SavedUser {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  savedListId String    @map("saved_list_id") @db.ObjectId
  savedList   SavedList @relation(fields: [savedListId], references: [id], onDelete: Cascade)

  /// خریدار نشان‌شده
  targetUserId String @map("target_user_id") @db.ObjectId
  targetUser   User   @relation("SavedTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  /// following | not_needed | unresponsive | out_of_stock |
  /// priority_high | priority_medium | priority_low
  status      String  @default("following")
  notes       SavedUserNote[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([savedListId, targetUserId])
  @@index([targetUserId])
}

/// یادداشت زمان‌دار روی خریدار نشان‌شده — «یادم باشه زنگ بزنم»
model SavedUserNote {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  savedUserId String    @map("saved_user_id") @db.ObjectId
  savedUser   SavedUser @relation(fields: [savedUserId], references: [id], onDelete: Cascade)

  text        String

  createdAt DateTime @default(now()) @map("created_at")

  @@index([savedUserId, createdAt(sort: Desc)])
}

// ─── چت و پیام‌ها (B8) ───────────────────────────────────────────────────────

// ─── کیف پول و نردبان (B9) ───────────────────────────────────────────────────

/// سفارش شارژ کیف پول — کارت‌به‌کارت (جایگزین درگاه پرداخت): کاربر یکی از ۳
/// پکیج را به کارت ایمچ واریز می‌کند و تصویر فیش را می‌فرستد؛ ادمین تأیید/رد
/// می‌کند و شارژ (با احتساب درصد اضافه) به موجودی اضافه می‌شود.
/// فیش در جدول File (relatedModel=ChargeOrder, fieldKey=receipt) — دکترین
/// ضد-فایل-سرگردان imach-back: اسلات تک‌فایلی با replace + جبران در خطا.
model ChargeOrder {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @map("user_id") @db.ObjectId
  user      User     @relation("ChargeOrderOwner", fields: [userId], references: [id], onDelete: Cascade)

  /// کلید پکیج — p100 | p200 | p400
  packageKey   String  @map("package_key")
  /// مبلغ واریزی کارت‌به‌کارت (تومان)
  amount       Int
  /// درصد شارژ اضافه (۰ | ۱۰ | ۲۰)
  bonusPercent Int     @map("bonus_percent")
  /// اعتبار افزوده به کیف پول پس از تأیید (با احتساب شارژ اضافه)
  charge       Int

  /// pending | approved | rejected
  status         String   @default("pending")
  rejectionReason String? @map("rejection_reason")
  /// کاربر ادمین بررسی‌کننده
  reviewedBy String?   @map("reviewed_by") @db.ObjectId
  reviewedAt DateTime? @map("reviewed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
}

/// اصلاح دستی کیف پول توسط ادمین (فاز A3) — شارژ یا کسر با دلیل.
/// در تاریخچه تراکنش‌های کاربر با عنوان «اصلاح کیف پول» دیده می‌شود؛
/// موجودیت بعدیِ ثبت (balanceAfter) مرور حساب را ممکن می‌کند.
model WalletAdjustment {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @map("user_id") @db.ObjectId
  user   User   @relation("WalletAdjustmentOwner", fields: [userId], references: [id], onDelete: Cascade)

  /// مثبت = شارژ دستی؛ منفی = کسر (تومان)
  amount    Int
  /// دلیل — به کاربر نمایش داده می‌شود
  reason    String
  /// کاربر ادمین انجام‌دهنده
  adminId   String @map("admin_id") @db.ObjectId
  /// موجودی پس از اعمال — برای مرور حساب
  balanceAfter Int @map("balance_after")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt(sort: Desc)])
}

/// نردبان آگهی — تنها قابلیت تبلیغاتی مگان (۱۰۰هزار تومان/ماه؛ بدون VIP و
/// «فروشنده ویژه» — خواسته مالک). هزینه لحظه خرید از کیف پول کسر می‌شود؛
/// is_ladder + ladder_expires_at روی خود آگهی denorm می‌شوند و سورت
/// «مرتبط‌ترین» نردبان‌های زنده را صدر می‌گذارد. تمدید = امتداد از انقضای
/// فعلی. انقضا با فیلتر زنده لیست + reaper دوره‌ای ماژول wallet غیرفعال می‌شود.
model LadderOrder {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  productId Int
  product   Product  @relation("LadderProduct", fields: [productId], references: [id])
  userId    String   @map("user_id") @db.ObjectId
  user      User     @relation("LadderOrderOwner", fields: [userId], references: [id], onDelete: Cascade)

  /// مبلغ پرداختی از کیف پول (تومان) — ثابت ۱۰۰هزار
  amount    Int
  startsAt  DateTime @map("starts_at")
  expiresAt DateTime @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([productId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([expiresAt])
}

/// مکالمه روی آگهی — خریدار ↔ فروشنده برای یک محصول مشخص (عین باسکول).
/// یک مکالمه به‌ازای هر خریدار روی هر آگهی؛ فروشنده = مالک آگهی (denorm).
model ChatThread {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  /// آگهی زمینه مکالمه — null یعنی گفتگوی مستقیم از پروفایل فروشنده
  /// (عین «ارسال پیام» باسکول در پروفایل؛ بدون آگهی خاص).
  productId Int?
  product   Product? @relation("ChatThreadProduct", fields: [productId], references: [id])

  sellerId  String   @map("seller_id") @db.ObjectId
  seller    User     @relation("ChatThreadSeller", fields: [sellerId], references: [id])
  buyerId   String   @map("buyer_id") @db.ObjectId
  buyer     User     @relation("ChatThreadBuyer", fields: [buyerId], references: [id])

  /// برای سورت لیست مکالمات بدون join آخرین پیام
  lastMessageAt DateTime? @map("last_message_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  messages ChatMessage[]

  /// با productId=null مونگو null را مقدار می‌شمارد → حداکثر یک گفتگوی
  /// مستقیم بین هر خریدار↔فروشنده؛ با productId همان یک مکالمه روی آگهی.
  @@unique([sellerId, buyerId, productId])
  @@index([sellerId, lastMessageAt(sort: Desc)])
  @@index([buyerId, lastMessageAt(sort: Desc)])
}

/// پیام — متن ساده در v1 (بدون فایل)؛ خوانده‌شدن با readAt
model ChatMessage {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  threadId  String     @map("thread_id") @db.ObjectId
  thread    ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  /// فرستنده — عضو مکالمه اعتبارسنجی می‌شود
  senderId  String     @map("sender_id") @db.ObjectId
  text      String
  readAt    DateTime?  @map("read_at")

  createdAt DateTime   @default(now()) @map("created_at")

  @@index([threadId, createdAt(sort: Desc)])
  @@index([threadId, readAt])
}

/// پیام مستقیم پشتیبانی (ادمین → کاربر) — یک‌طرفه برای اطلاع‌رسانی/حذف نرم
/// اعلان‌ها. هر ردیف = یک پیام برای «یک» کاربر؛ ارسال گروهی/همه ردیف‌های
/// جدا می‌سازد تا خوانده‌شدن per-user دقیق بماند (الگوی denorm باسکول).
/// user-side: مکالمه سنجاق‌شده «پشتیبانی ایمچ» در /panel/messages.
model AdminMessage {
  id     String  @id @default(auto()) @map("_id") @db.ObjectId
  userId String  @map("user_id") @db.ObjectId
  user   User    @relation("AdminMessageOwner", fields: [userId], references: [id], onDelete: Cascade)

  /// نام کاربری ادمین فرستنده (نمایشی) — AdminUser جداست؛ username کافی است
  adminUsername String @map("admin_username")
  /// متن پیام — ساده در v1 (بدون فایل/عنوان)
  text    String

  /// null = خوانده‌نشده — با باز کردن مکالمه پشتیبانی توسط کاربر پر می‌شود
  readAt  DateTime? @map("read_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt(sort: Desc)])
  @@index([readAt, createdAt(sort: Desc)])
}

/// گزارش تماس کاربر-به-کاربر (A6).
/// چرا: در مدل MVP ایمچ کاربران را خودمان در دیتابیس می‌ریزیم؛ خریدار
/// شماره فروشنده را می‌بیند و بیرون سایت زنگ می‌زند. تنها سیگنال قابل
/// ثبتِ وب، لحظه‌ی «آشکارسازی شماره» است — همان لحظه ثبت می‌شود تا
/// ادمین بداند چه کسی با چه کسی در حال معامله است و حجم تماس‌ها چقدر است.
model CallLog {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  /// تماس‌گیرنده — کسی که شماره را دید
  callerId String @map("caller_id") @db.ObjectId
  caller   User   @relation("CallCaller", fields: [callerId], references: [id])

  /// دریافت‌کننده — صاحب شماره
  calleeId String @map("callee_id") @db.ObjectId
  callee   User   @relation("CallCallee", fields: [calleeId], references: [id])

  /// زمینه آشکارسازی شماره — صفحه آگهی / پروفایل / چت
  source    String   @default("product") // product | profile | chat
  productId Int?     @map("product_id")
  product   Product? @relation("CallLogProduct", fields: [productId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@index([calleeId, createdAt(sort: Desc)])
  @@index([callerId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
}

/// نظر کاربران درباره فروشنده (عین «نظرات کاربران» باسکول در پروفایل):
/// امتیاز ۱..۵ + متن؛ هر کاربر حداکثر یک نظر برای هر فروشنده (upsert) —
/// ویرایش نظر خودش آزاد است. خودفروشی نظر (نظر درباره خود) ممنوع.
model SellerReview {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  /// فروشنده‌ای که نظر درباره‌اش است
  sellerId String @map("seller_id") @db.ObjectId
  seller   User   @relation("ReviewSeller", fields: [sellerId], references: [id])

  /// نویسنده نظر
  authorId String @map("author_id") @db.ObjectId
  author   User   @relation("ReviewAuthor", fields: [authorId], references: [id])

  /// ۱ تا ۵ ستاره
  rating Int
  /// متن نظر — حداکثر ~۱۰۰۰ نویسه
  text   String

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([authorId, sellerId])
  @@index([sellerId, createdAt(sort: Desc)])
}
