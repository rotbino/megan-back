// Megan Backend — Prisma Schema
// طراحی‌شده منطبق بر ساختار داده باسکول (buskool.com) برای مهاجرت بی‌دردسر داده‌ها
// ستون‌های دیتابیس با @map دقیقاً مطابق نام فیلدهای باسکول (snake_case) هستند
// تا اسکریپت انتقال داده مستقیماً و بدون تبدیل پیچیده کار کند.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // اگر دامپ فعلی شما MySQL است فقط همین provider را به "mysql" تغییر دهید.
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Users — جدول باسکول: myusers
// ─────────────────────────────────────────────────────────────

enum Role {
  USER
  SELLER
  ADMIN
}

enum PackageType {
  FREE // 0 — عضویت رایگان
  BASIC // 1 — فروشنده عادی
  SPECIAL // 2 — فروشنده ویژه (is_elevated محصولات)
}

model User {
  id               Int         @id @default(autoincrement())
  phone            String      @unique // ورود فقط با موبایل + OTP
  userName         String?     @unique @map("user_name") // شناسه پروفایل عمومی مثل c34qxnsh
  firstName        String      @map("first_name")
  lastName         String      @map("last_name")
  sex              String? // «آقا» / «خانم» — مثل باسکول
  role             Role        @default(USER)
  activePakageType PackageType @default(FREE) @map("active_pakage_type") // نگهداری املای باسکول برای مهاجرت (در ایمچ v1 کاربرد ندارد)
  isVerified       Boolean     @default(false) @map("is_verified") // احراز هویت حقیقی/حقوقی
  isBuyer          Boolean     @default(false) @map("is_buyer")
  isSeller         Boolean     @default(false) @map("is_seller")
  walletBalance    Int         @default(0) @map("wallet_balance") // تومان — کیف پول پنل
  avatarUrl        String?     @map("avatar_url")
  businessDesc     String?     @map("business_desc") // «درباره کسب‌وکار» پروفایل
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  profile      UserProfile?
  products     Product[]
  buyRequests  BuyRequest[]
  reviewsGiven Review[]      @relation("Reviewer")
  reviewsTaken Review[]      @relation("Reviewed")
  favorites    Favorite[]
  chatThreadsA ChatThread[]  @relation("ThreadUserA")
  chatThreadsB ChatThread[]  @relation("ThreadUserB")
  messages     ChatMessage[]
  ladderOrders LadderOrder[]
  chargeOrders ChargeOrder[] // شارژهای کارت به کارت کیف پول (تایید در پنل ادمین)
  savedLists   SavedList[] // لیست‌های «نشان شده ها» پنل (CRM کوچک)
  savedBy      SavedUser[]   @relation("SavedBy") // مواردی که کاربران دیگر این کاربر را نشان کرده‌اند

  @@index([activePakageType, isVerified])
  @@map("myusers")
}

// ─────────────────────────────────────────────────────────────
// پروفایل پنل — منطبق بر پاسخ user/get_profile باسکول
// (فیلدهای جدول myuser_profiles باسکول برای مهاجرت ۱:۱)
// ─────────────────────────────────────────────────────────────
model UserProfile {
  id                  Int      @id @default(autoincrement())
  myuserId            Int      @unique @map("myuser_id")
  myuser              User     @relation(fields: [myuserId], references: [id], onDelete: Cascade)
  description         String?  @db.Text // «درباره شما» — پنل حداقل ۳ تا ۵ خط می‌خواهد
  activityDomain      String?  @map("activity_domain")
  humanResourceCount  Int?     @map("human_resource_count")
  profilePhoto        String?  @map("profile_photo")
  publicPhone         String?  @map("public_phone") // تلفن عمومی پروفایل
  address             String? // «تهران - تهران»
  postalCode          String?  @map("postal_code")
  shabaCode           String?  @map("shaba_code")
  isCompany           Boolean  @default(false) @map("is_company")
  companyName         String   @default("") @map("company_name")
  companyRegisterCode String   @default("") @map("company_register_code")
  confirmed           Boolean  @default(false) // تأیید کارشناسان
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("myuser_profiles")
}

// ─────────────────────────────────────────────────────────────
// Categories — درخت سه‌سطحی باسکول (مثل: کشاورزی ← خشکبار ← پسته)
// + «نوع کالا» در همان جدول (kind=PRODUCT_TYPE) — فرزندِ برگ دسته‌ها
// ─────────────────────────────────────────────────────────────

// نوع نود: دسته‌بندی معمولی یا «نوع کالا» (ورودی آزاد کاربران مثل: اکبری، فندقی)
// نوع کالاها از فرم «ثبت درخواست خرید» می‌آیند و زیر آخرین نودِ دسته کالا
// ذخیره می‌شوند تا جدول نوع‌کالا به‌مرور شکل بگیرد؛ بعداً برای تطبیق
// درخواست‌های خرید با فروشندگان همان کالا (نمایش در پنل کاربری) استفاده می‌شوند.
enum CategoryKind {
  CATEGORY // نود دسته‌بندی (ریشه/میانی/برگ)
  PRODUCT_TYPE // نوع کالا — فرزند برگ؛ ورودی آزاد کاربر
}

model Category {
  id           Int          @id @default(autoincrement())
  categoryName String       @map("category_name")
  slug         String       @unique // برای URL فارسی‌پسند مثل باسکول: /product-list/category/پسته
  kind         CategoryKind @default(CATEGORY) // دسته‌بندی یا نوع کالا
  unit         String       @default("کیلوگرم") // واحد فروش پیش‌فرض دسته
  min          Int          @default(100) // حداقل سفارش پیش‌فرض (باسکول: پسته=500)
  example      String? // نمونه ورودی فرم مثل «فندقی»
  parentId     Int?         @map("parent_id")
  parent       Category?    @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children     Category[]   @relation("CategoryTree")
  score        Int          @default(0) // وزن محبوبیت برای مرتب‌سازی (باسکول: میوه خشک=8272)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  products    Product[]    @relation("ProductSubCategory")
  parentRefs  Product[]    @relation("ProductCategory")
  buyRequests BuyRequest[]

  // فیلتر رایج: زیرشاخه‌های یک نود به تفکیک نوع (دسته/نوع‌کالا) با مرتب‌سازی score
  @@index([parentId, kind, score])
  @@map("categories")
}

// ─────────────────────────────────────────────────────────────
// Location — مثل باسکول: ۳۱ استان + شهرها (province_id کرمان=21، اصفهان=4)
// ─────────────────────────────────────────────────────────────

model Province {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  cities      City[]
  products    Product[]
  buyRequests BuyRequest[]

  @@map("provinces")
}

model City {
  id          Int          @id @default(autoincrement())
  name        String
  provinceId  Int          @map("province_id")
  province    Province     @relation(fields: [provinceId], references: [id], onDelete: Cascade)
  products    Product[]
  buyRequests BuyRequest[]

  @@index([provinceId])
  @@map("cities")
}

// ─────────────────────────────────────────────────────────────
// Products — جدول باسکول: products (تمام فیلدهای استخراج‌شده از API)
// ─────────────────────────────────────────────────────────────

enum ProductStatus {
  PENDING // در انتظار تایید
  CONFIRMED // تایید شده
  REJECTED // رد شده
  DELETED // حذف شده
}

model Product {
  id            Int           @id @default(autoincrement())
  productName   String        @map("product_name") // «پسته اکبری20_22»
  description   String        @db.Text
  stock         Int           @default(0) // موجودی آماده فروش (کیلوگرم/عدد)
  minSalePrice  Int?          @map("min_sale_price") // کف قیمت هر واحد (تومان) — 3700000
  minSaleAmount Int           @map("min_sale_amount") // حداقل میزان فروش در هر معامله — 1000
  unit          String        @default("کیلوگرم")
  status        ProductStatus @default(PENDING) // تب‌های «محصولات من» پنل

  // نرمال‌شده مثل باسکول: هم دسته پدر (خشکبار) هم دسته برگ (پسته)
  categoryId    Int      @map("category_id")
  category      Category @relation("ProductCategory", fields: [categoryId], references: [id])
  subCategoryId Int      @map("sub_category_id")
  subCategory   Category @relation("ProductSubCategory", fields: [subCategoryId], references: [id])

  provinceId Int      @map("province_id")
  province   Province @relation(fields: [provinceId], references: [id])
  cityId     Int      @map("city_id")
  city       City     @relation(fields: [cityId], references: [id])

  myuserId Int  @map("myuser_id") // نگهداری نام فیلد باسکول برای مهاجرت
  myuser   User @relation(fields: [myuserId], references: [id], onDelete: Cascade)

  isElevated Boolean @default(false) @map("is_elevated") // فروشنده ویژه باسکول — در ایمچ v1 کاربرد ندارد (فقط برای مهاجرت داده)
  isLadder   Boolean @default(false) @map("is_ladder") // نردبان: آگهی فعال نردبان‌شده — بالای نتایج می‌آید (denorm از LadderOrder)
  hasVideo   Boolean @default(false) @map("has_video")
  isOld      Boolean @default(false) @map("is_old") // آگهی کهنه/نیازمند به‌روزرسانی قیمت
  viewCount  Int     @default(0) @map("view_count")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  photos       Photo[]
  favorites    Favorite[]
  priceRecords PriceHistory[]
  chatThreads  ChatThread[]
  ladderOrders LadderOrder[]
  features     ProductFeature[] // «جزئیات نهایی» فرم ثبت محصول

  // مرتب‌سازی «مرتبط‌ترین» باسکول (sort_by=BM): نردبان‌ها اول
  @@index([subCategoryId, isLadder, updatedAt])
  @@index([categoryId])
  @@index([provinceId, cityId])
  @@index([myuserId])
  @@map("products")
}

// ─────────────────────────────────────────────────────
// نردبان آگهی — تنها قابلیت تبلیغاتی ایمچ v1
// تعرفه: ۱۰٬۰۰۰ تومان برای هر آگهی در هر روز
// (is_ladder روی Product به‌صورت denorm نگه داشته می‌شود تا سورت سریع بماند)
// ─────────────────────────────────────────────────────

enum LadderOrderStatus {
  PENDING // در انتظار پرداخت
  ACTIVE // در حال نردبان
  FINISHED // تمام‌شده
  CANCELED // لغو‌شده
}

model LadderOrder {
  id           Int               @id @default(autoincrement())
  productId    Int               @map("product_id")
  product      Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  myuserId     Int               @map("myuser_id")
  myuser       User              @relation(fields: [myuserId], references: [id], onDelete: Cascade)
  // نردبان هر محصول برای «یک ماه» (۳۰ روز) ۱۰۰٬۰۰۰ تومان است؛
  // هزینه از شارژ کیف پول (walletBalance) کسر می‌شود — حداقل شارژ ۱۰۰٬۰۰۰ تومان
  startDate    DateTime          @map("start_date")
  endDate      DateTime          @map("end_date")
  months       Int               @default(1) // تعداد ماه‌های نردبان (v1: همیشه ۱)
  monthlyPrice Int               @default(100000) @map("monthly_price") // تومان برای هر ماه
  totalPrice   Int               @map("total_price") // months × monthlyPrice
  status       LadderOrderStatus @default(PENDING)
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  @@index([productId, status])
  @@index([myuserId, status])
  @@map("ladder_orders")
}

// ─────────────────────────────────────────────────────────────
// شارژ کیف پول — پرداخت کارت به کارت (جایگزین درگاه پرداخت):
// کاربر مبلغ را کارت به کارت می‌کند، تصویر فیش را برای ادمین می‌فرستد و
// پس از تایید در پنل ادمین، شارژ (با بونوس) به walletBalance اضافه می‌شود.
// پکیج‌ها: ۱۰۰ هزار (بدون بونوس) / ۲۰۰ هزار (+۱۰٪) / ۴۰۰ هزار (+۲۰٪)
// ─────────────────────────────────────────────────────────────

enum ChargeOrderStatus {
  PENDING // فیش ارسال شده — در انتظار تایید ادمین
  CONFIRMED // تایید شده — شارژ به کیف پول اضافه شد
  REJECTED // رد شده — فیش نامعتبر
}

enum ChargePackageKey {
  P100 // ۱۰۰ هزار تومان — بدون شارژ اضافه
  P200 // ۲۰۰ هزار تومان — ۱۰٪ شارژ اضافه
  P400 // ۴۰۰ هزار تومان — ۲۰٪ شارژ اضافه
}

model ChargeOrder {
  id           Int               @id @default(autoincrement())
  myuserId     Int               @map("myuser_id")
  myuser       User              @relation(fields: [myuserId], references: [id], onDelete: Cascade)
  packageKey   ChargePackageKey  @map("package_key")
  amount       Int // مبلغ واریزشده کارت به کارت (تومان)
  bonusPercent Int               @default(0) @map("bonus_percent") // ۰ / ۱۰ / ۲۰ درصد شارژ اضافه
  chargeAmount Int               @map("charge_amount") // شارژ نهایی اعمالی = amount × (۱ + درصد)
  receiptPhoto String?           @map("receipt_photo") // مسیر تصویر فیش واریزی
  status       ChargeOrderStatus @default(PENDING)
  adminNote    String?           @map("admin_note") // یادداشت ادمین هنگام تایید/رد
  createdAt    DateTime          @default(now()) @map("created_at")
  confirmedAt  DateTime?         @map("confirmed_at")

  @@index([myuserId, status])
  @@map("charge_orders")
}

model Photo {
  id        Int     @id @default(autoincrement())
  productId Int     @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  filePath  String  @map("file_path") // URL آبجکت‌استوریج (مثل ArvanCloud S3 در باسکول)
  sortOrder Int     @default(0) @map("sort_order")

  @@index([productId])
  @@map("photos")
}

// ─────────────────────────────────────────────────────────────
// Buy Requests (RFQ) — درخواست‌های خرید
// فیلدها مطابق خروجی get_buyAd_list باسکول
// ─────────────────────────────────────────────────────────────

enum BuyRequestStatus {
  ACTIVE
  FULFILLED
  EXPIRED
}

model BuyRequest {
  id                Int              @id @default(autoincrement())
  // ⚠️ نام‌گذاری گیج‌کننده ولی عین باسکول (کلمه‌به‌کلمه از get_buyAd_list):
  //   name              = «نوع محصول»  (مثل: پاجوش پیارم / پد بهداشتی پارچه‌ای)
  //   category (رابطه)  = دسته برگ واقعی محصول (مثل: نهال) — در پاسخ باسکول subcategory_name
  // جمله کارت باسکول: «خریدار {requirement_amount} {unit} {subcategory_name} از نوع {name} هستم»
  // فاز بعد: name به نود PRODUCT_TYPE جدول categories ارجاع می‌شود (تطبیق درخواست با فروشندگان همان نوع کالا).
  name              String? // نوع محصول — در باسکول nullable است
  description       String?          @db.Text
  categoryId        Int              @map("category_id")
  category          Category         @relation(fields: [categoryId], references: [id])
  requirementAmount Int              @map("requirement_amount") // 600 / 10000
  unit              String           @default("کیلوگرم")
  myuserId          Int              @map("myuser_id")
  myuser            User             @relation(fields: [myuserId], references: [id], onDelete: Cascade)
  provinceId        Int?             @map("province_id")
  province          Province?        @relation(fields: [provinceId], references: [id])
  cityId            Int?             @map("city_id")
  city              City?            @relation(fields: [cityId], references: [id])
  status            BuyRequestStatus @default(ACTIVE)
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  @@index([categoryId, status, createdAt])
  @@index([myuserId])
  @@map("buy_requests")
}

// ─────────────────────────────────────────────────────────────
// Trust & Engagement
// ─────────────────────────────────────────────────────────────

model Review {
  id         Int      @id @default(autoincrement())
  reviewerId Int      @map("reviewer_id")
  reviewer   User     @relation("Reviewer", fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewedId Int      @map("reviewed_id")
  reviewed   User     @relation("Reviewed", fields: [reviewedId], references: [id], onDelete: Cascade)
  rating     Int // 1..5
  comment    String   @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([reviewerId, reviewedId])
  @@index([reviewedId, createdAt])
  @@map("reviews")
}

model Favorite {
  userId    Int      @map("myuser_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId Int      @map("product_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@id([userId, productId])
  @@map("favorites")
}

// ─────────────────────────────────────────────────────────────
// ویژگی‌های محصول — مرحله «جزئیات نهایی» ثبت محصول
// کلیدها ثابت فرانت: بسته‌بندی/کیفیت/رنگ/اندازه یا ابعاد/گواهی کیفی، سلامت/
// تازگی/نوع فروش/روش نگهداری یا ماندگاری/مزایا نسبت به محصولات مشابه
// ─────────────────────────────────────────────────────────────
model ProductFeature {
  id         Int     @id @default(autoincrement())
  productId  Int     @map("product_id")
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  featureKey String  @map("feature_key")
  value      String

  @@unique([productId, featureKey])
  @@map("product_features")
}

// ─────────────────────────────────────────────────────────────
// نشان شده ها — CRM کوچک پیگیری مشتری (مثل باسکول)
// کاربر پنل خریداران را در لیست‌های نام‌دار نشان می‌کند؛
// هر مورد وضعیت پیگیری + یادداشت‌های زمان‌دار دارد.
// پاسخ سرویس: { status, lists: [{ id, name, cnt, saved }] }
// ─────────────────────────────────────────────────────────────
enum SavedUserStatus {
  FOLLOWING // در حال پیگیری
  NOT_NEEDED // فعلا نیاز نداشت
  UNRESPONSIVE // پاسخگو نبود
  OUT_OF_STOCK // موجودی نداشت
  PRIORITY_HIGH // اولویت زیاد
  PRIORITY_MEDIUM // اولویت متوسط
  PRIORITY_LOW // اولویت کم
}

model SavedList {
  id        Int      @id @default(autoincrement())
  myuserId  Int      @map("myuser_id")
  myuser    User     @relation(fields: [myuserId], references: [id], onDelete: Cascade)
  name      String // «سیب زمینی»
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  savedUsers SavedUser[]

  @@unique([myuserId, name])
  @@map("saved_lists")
}

model SavedUser {
  id          Int             @id @default(autoincrement())
  savedListId Int             @map("saved_list_id")
  savedList   SavedList       @relation(fields: [savedListId], references: [id], onDelete: Cascade)
  myuserId    Int             @map("saved_myuser_id") // خریدار نشان‌شده
  myuser      User            @relation("SavedBy", fields: [myuserId], references: [id], onDelete: Cascade)
  status      SavedUserStatus @default(FOLLOWING)
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  notes SavedUserNote[]

  @@unique([savedListId, myuserId])
  @@map("saved_users")
}

model SavedUserNote {
  id          Int       @id @default(autoincrement())
  savedUserId Int       @map("saved_user_id")
  savedUser   SavedUser @relation(fields: [savedUserId], references: [id], onDelete: Cascade)
  text        String    @db.Text // «یادم باشه زنگ بزنم»
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("saved_user_notes")
}

// تاریخچه قیمت برای نمودار روند (بهبود نسبت به باسکول)
model PriceHistory {
  id         Int      @id @default(autoincrement())
  productId  Int      @map("product_id")
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  price      Int // تومان
  recordedAt DateTime @map("recorded_at")

  @@index([productId, recordedAt])
  @@map("price_histories")
}

// ─────────────────────────────────────────────────────────────
// Chat — اسکلت گفتگو خریدار/فروشنده (فاز بعدی: WebSocket)
// ─────────────────────────────────────────────────────────────

model ChatThread {
  id            Int      @id @default(autoincrement())
  productId     Int      @map("product_id")
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userAId       Int      @map("user_a_id")
  userA         User     @relation("ThreadUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userBId       Int      @map("user_b_id")
  userB         User     @relation("ThreadUserB", fields: [userBId], references: [id], onDelete: Cascade)
  lastMessageAt DateTime @default(now()) @map("last_message_at")

  messages ChatMessage[]

  @@unique([productId, userAId, userBId])
  @@map("chat_threads")
}

model ChatMessage {
  id        Int        @id @default(autoincrement())
  threadId  Int        @map("thread_id")
  thread    ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderId  Int        @map("sender_id")
  sender    User       @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body      String     @db.Text
  readAt    DateTime?  @map("read_at")
  createdAt DateTime   @default(now()) @map("created_at")

  @@index([threadId, createdAt])
  @@map("chat_messages")
}

// ─────────────────────────────────────────────────────────────
// Auth — کدهای یک‌بار مصرف ورود با موبایل (همان الگوی باسکول)
// ─────────────────────────────────────────────────────────────

model OtpCode {
  id         Int       @id @default(autoincrement())
  phone      String
  codeHash   String    @map("code_hash")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  tries      Int       @default(0)
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([phone, expiresAt])
  @@map("otp_codes")
}
